Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Help Height: 0
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 24
      Offset: {X: 10, Y: 6, Z: 0}
      Color: 160; 160; 164
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/Path
      Name: Planned path (/mission/path)
      Enabled: true
      Topic:
        Value: /mission/path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        Depth: 1
      Color: 235; 104; 52
      Line Style: Billboards
      Line Width: 0.04
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Ground truth (/ground_truth/odom)
      Enabled: true
      Topic:
        Value: /ground_truth/odom
        Reliability Policy: Best Effort
        Depth: 5
      Keep: 20000
      Position Tolerance: 0.25
      Angle Tolerance: 0.3
      Shape:
        Value: Arrow
        Color: 27; 175; 122
        Alpha: 1
        Shaft Length: 0.3
        Shaft Radius: 0.03
        Head Length: 0.1
        Head Radius: 0.07
      Covariance:
        Value: false
      Value: true
    - Class: rviz_default_plugins/Odometry
      Name: Mission pose (/localization/odom)
      Enabled: true
      Topic:
        Value: /localization/odom
        Reliability Policy: Best Effort
        Depth: 5
      Keep: 1
      Shape:
        Value: Arrow
        Color: 42; 120; 214
        Alpha: 1
        Shaft Length: 0.7
        Shaft Radius: 0.06
        Head Length: 0.25
        Head Radius: 0.15
      Covariance:
        Value: false
      Value: true
  Global Options:
    Background Color: 250; 250; 248
    Fixed Frame: map
    Frame Rate: 15
  Name: root
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      X: 10
      Y: 6
      Angle: 0
      Scale: 52
      Target Frame: <Fixed Frame>
      Value: TopDownOrtho (rviz_default_plugins)
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Width: 1600
  X: 0
  Y: 0
  Hide Left Dock: false
  Hide Right Dock: true
