<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lawn_mower_electronics</name>
  <version>0.1.0</version>
  <description>Simulation models of the lawn mower robot's electronics: radio receiver, controller, motor driver, blade, battery and sensors.</description>
  <maintainer email="mothana.alsaady@teebatkarbala.iq">Muthana Ali</maintainer>
  <license>MIT</license>

  <exec_depend>lawn_mower_robot</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
